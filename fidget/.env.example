APP_NAME="Fidget Friendz"
APP_ENV=development
APP_KEY=base64:OWRNJFuw5a3Fum56/rnDoKsP6vCc7zC+cU7IVUX5h9w=
APP_DEBUG=true
APP_TIMEZONE=UTC

# Public URL served by edge Nginx
APP_URL=http://localhost
# Optional: if some code reads a "gateway" base URL explicitly
GATEWAY_SERVICE_BASE_URL=http://nginx

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# No external database required (use local SQLite file)
DB_CONNECTION=sqlite
DB_DATABASE=/tmp/fidgetfriends.sqlite
DB_FOREIGN_KEYS=true

# No Redis required
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# No Redis required (run jobs inline)
QUEUE_CONNECTION=sync

# No Redis required (filesystem cache)
CACHE_STORE=file
CACHE_PREFIX="frontend_service_cache_"

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_ETSY_URL="https://www.etsy.com/shop/YourShopName"
VITE_BRAND_EMAIL="hello@fidgetfriendz.com"
VITE_INSTAGRAM_URL="https://instagram.com/ShopFidgetFriendz"
VITE_FACEBOOK_URL="https://facebook.com/FidgetFriendz"

# Redis config not needed
# REDIS_PREFIX=""
# REDIS_CLIENT=phpredis
# REDIS_HOST=redis
# REDIS_PASSWORD=null
# REDIS_PORT=6379
